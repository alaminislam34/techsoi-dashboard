### get order info for admin  ---------------> order requests

GET {{URL}}/order
accept: application/json
content-type: application/json
Authorization: Bearer {{ADMINTOKEN}}

### get single order details

GET {{URL}}/order/1
accept: application/json
content-type: application/json
Authorization: Bearer {{ADMINTOKEN}}

### update order

PUT {{URL}}/order/1
accept: application/json
content-type: application/json
Authorization: Bearer {{ADMINTOKEN}}

{
    "pay_status": "1",
    "status": "1",
}

# pay_status 0 = due, 1 = paid
# status 1 = new order, 2 = panding, 3 = processing, 4 = in delivery, 5 = complete, 0 = cancel

### delete a order

DELETE {{URL}}/order/1
accept: application/json
Authorization: Bearer {{ADMINTOKEN}}

{
    "cancel_message": "Out of Stock",
}

### get order product info  ---------------> order details requests

PUT {{URL}}/order-details/1
accept: application/json
content-type: application/json
Authorization: Bearer {{ADMINTOKEN}}

{
    "pay_status": "1",
    "status": "1",
}

# pay_status 0 = due, 1 = paid
# status 1 = new order, 2 = panding, 3 = processing, 4 = in delivery, 5 = complete, 0 = cancel

### delete a order product

DELETE {{URL}}/order-details/1
accept: application/json
Authorization: Bearer {{ADMINTOKEN}}

{
    "cancel_message": "Out of Stock",
}

